{
	"id": "wetomate-example-duo-expense-approval",
	"name": "[Wetomate Example] Duo Expense Reimbursement Approval",
	"nodes": [
		{
			"parameters": {
				"content": "## Human approval workflow\n\n### How it works\n\nAn employee submits an expense request. The workflow preserves the form fields, checks the manager in Duo, and sends a synchronous Push with safe expense context. The approval gate routes an explicit allow result to the approved path; every other result follows the rejected path.\n\n### Setup\n\nCreate a Duo Auth API credential, replace the placeholder manager username, and test the form with a non-production expense before activation. Replace the outcome nodes with your finance, payroll, notification, or audit action.\n\n### Customization\n\nKeep the manager mapping trusted and keep Push Info concise. Never send receipts, payment card details, credentials, tokens, or other secrets in the authentication request.",
				"height": 644,
				"width": 416,
				"color": 5
			},
			"id": "wetomate-example-duo-expense-note-overview",
			"name": "Main workflow overview",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-496, -224]
		},
		{
			"parameters": {
				"content": "## Request and preserve input\n\nCollect the expense form fields and keep them available while adding the trusted manager username.",
				"height": 284,
				"width": 432,
				"color": 7
			},
			"id": "wetomate-example-duo-expense-note-push",
			"name": "Request and preserve input",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-48, -32]
		},
		{
			"parameters": {
				"content": "## Check and request Duo approval\n\nVerify the manager account, then send the expense reference, employee, amount, currency, and description in Push Info.",
				"height": 332,
				"width": 384,
				"color": 7
			},
			"id": "wetomate-example-duo-expense-note-next-step",
			"name": "Check and request Duo approval",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [416, -80]
		},
		{
			"parameters": {
				"content": "## Route the decision\n\nThe manager's explicit allow result selects the approved branch; the other branch records a rejection for follow-up.",
				"height": 524,
				"width": 496,
				"color": 7
			},
			"id": "wetomate-example-duo-expense-note-outcome",
			"name": "Route the decision",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [816, -176]
		},
		{
			"parameters": {
				"formTitle": "Expense reimbursement request",
				"formDescription": "Submit an expense for manager approval. The manager will receive a Duo Push with the request details.",
				"formFields": {
					"values": [
						{
							"fieldLabel": "Employee name",
							"fieldType": "text",
							"requiredField": true
						},
						{
							"fieldLabel": "Employee email",
							"fieldType": "email",
							"requiredField": true
						},
						{
							"fieldLabel": "Expense description",
							"fieldType": "text",
							"requiredField": true
						},
						{
							"fieldLabel": "Amount",
							"fieldType": "number",
							"requiredField": true
						},
						{
							"fieldLabel": "Currency",
							"fieldType": "text",
							"defaultValue": "USD",
							"requiredField": true
						},
						{
							"fieldLabel": "Expense date",
							"fieldType": "date",
							"requiredField": true
						},
						{
							"fieldLabel": "Expense reference",
							"fieldType": "text",
							"placeholder": "EXP-1042",
							"requiredField": true
						}
					]
				},
				"options": { "appendAttribution": false }
			},
			"id": "wetomate-example-duo-expense-form",
			"name": "Expense Request Form",
			"type": "n8n-nodes-base.formTrigger",
			"typeVersion": 2.2,
			"position": [0, 96]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "wetomate-example-duo-expense-manager",
							"name": "managerUsername",
							"type": "string",
							"value": "manager@example.com"
						}
					]
				},
				"includeOtherFields": true,
				"options": {}
			},
			"id": "wetomate-example-duo-expense-context",
			"name": "Set Approval Context",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [224, 96]
		},
		{
			"parameters": {
				"endpoint": "preauth",
				"userIdentifier": {
					"mode": "username",
					"value": "={{ $json.managerUsername }}"
				},
				"preAuthOptionalFields": {
					"clientSupportsVerifiedPush": true
				}
			},
			"id": "wetomate-example-duo-expense-preauth",
			"name": "Check Manager Access",
			"type": "n8n-nodes-duo.duoSecurity",
			"typeVersion": 1,
			"position": [448, 96]
		},
		{
			"parameters": {
				"endpoint": "auth",
				"userIdentifier": {
					"mode": "username",
					"value": "={{ $('Set Approval Context').item.json.managerUsername }}"
				},
				"factor": "push",
				"device": "auto",
				"pushinfo": {
					"pairs": [
						{
							"key": "expense",
							"value": "={{ $('Set Approval Context').item.json['Expense reference'] }}"
						},
						{
							"key": "employee",
							"value": "={{ $('Set Approval Context').item.json['Employee name'] }}"
						},
						{
							"key": "amount",
							"value": "={{ $('Set Approval Context').item.json.Amount }} {{ $('Set Approval Context').item.json.Currency }}"
						},
						{
							"key": "description",
							"value": "={{ $('Set Approval Context').item.json['Expense description'] }}"
						}
					]
				},
				"authOptionalFields": {
					"async": false,
					"display_username": "={{ $('Set Approval Context').item.json['Employee email'] }}",
					"type": "Expense reimbursement approval"
				}
			},
			"id": "wetomate-example-duo-expense-auth",
			"name": "Request Manager Approval",
			"type": "n8n-nodes-duo.duoSecurity",
			"typeVersion": 1,
			"position": [672, 96]
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "wetomate-example-duo-expense-allow",
							"leftValue": "={{ $json.result.response.result }}",
							"rightValue": "allow",
							"operator": { "type": "string", "operation": "equals" }
						}
					],
					"combinator": "and"
				}
			},
			"id": "wetomate-example-duo-expense-if",
			"name": "Manager Approved?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [896, 96]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "wetomate-example-duo-expense-approved-status",
							"name": "status",
							"type": "string",
							"value": "approved"
						},
						{
							"id": "wetomate-example-duo-expense-approved-action",
							"name": "nextAction",
							"type": "string",
							"value": "Send this approved expense to finance or payroll"
						}
					]
				},
				"options": {}
			},
			"id": "wetomate-example-duo-expense-approved",
			"name": "Mark Expense Approved",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [1120, 0]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "wetomate-example-duo-expense-denied-status",
							"name": "status",
							"type": "string",
							"value": "denied"
						},
						{
							"id": "wetomate-example-duo-expense-denied-action",
							"name": "nextAction",
							"type": "string",
							"value": "Notify the employee and record the rejection"
						}
					]
				},
				"options": {}
			},
			"id": "wetomate-example-duo-expense-denied",
			"name": "Record Expense Rejection",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [1120, 192]
		}
	],
	"connections": {
		"Expense Request Form": {
			"main": [[{ "node": "Set Approval Context", "type": "main", "index": 0 }]]
		},
		"Set Approval Context": {
			"main": [[{ "node": "Check Manager Access", "type": "main", "index": 0 }]]
		},
		"Check Manager Access": {
			"main": [[{ "node": "Request Manager Approval", "type": "main", "index": 0 }]]
		},
		"Request Manager Approval": {
			"main": [[{ "node": "Manager Approved?", "type": "main", "index": 0 }]]
		},
		"Manager Approved?": {
			"main": [
				[{ "node": "Mark Expense Approved", "type": "main", "index": 0 }],
				[{ "node": "Record Expense Rejection", "type": "main", "index": 0 }]
			]
		}
	},
	"active": false,
	"settings": { "executionOrder": "v1" }
}
