{
	"name": "@wetomate/nodes",
	"version": "0.0.0",
	"private": true,
	"description": "Wetomate's toolkit and community nodes for n8n",
	"license": "MIT",
	"workspaces": [
		"wetomate-node-toolkit",
		"n8n-nodes-*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check:packages": "node scripts/validate-community-node-packages.js",
		"dev": "sh scripts/dev-environment.sh up",
		"dev:check": "sh scripts/dev-environment.sh check",
		"dev:down": "sh scripts/dev-environment.sh down",
		"dev:restart": "sh scripts/dev-environment.sh restart",
		"dev:seed": "sh scripts/dev-environment.sh seed",
		"dev:shell": "sh scripts/dev-environment.sh shell",
		"dev:watch": "node scripts/watch-community-node-packages.js",
		"lint": "npm run lint --workspaces --if-present",
		"test": "npm run test:scripts && npm run test --workspaces --if-present",
		"test:scripts": "node --test scripts/*.test.js"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"jsonc-eslint-parser": "^2.4.1"
	},
	"engines": {
		"node": ">=22"
	}
}
